<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DualSenseEmu.Gui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <!-- app indigo instead of Windows blue for toggles, focus rings and selection -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#6C8CFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>
