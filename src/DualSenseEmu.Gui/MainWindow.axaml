<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DualSenseEmu.Gui.MainWindow"
        Title="DualSense Emulator" Icon="/Assets/icon.png" Width="1040" SizeToContent="Height" CanResize="False"
        RequestedThemeVariant="Dark" ExtendClientAreaToDecorationsHint="True">
  <Window.Background>
    <SolidColorBrush Color="#0B0D14" />
  </Window.Background>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#11141C" />
      <Setter Property="BorderBrush" Value="#14EEF0F5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#7A8296" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#EEF0F5" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#11141C" />
      <Setter Property="BorderBrush" Value="#14EEF0F5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- the "Translating" badges between the two pads -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#1A1E28" />
      <Setter Property="BorderBrush" Value="#14EEF0F5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- mode buttons: Emulate (accent hairline) / Passthrough (amber hairline) -->
    <Style Selector="Button.mode">
      <Setter Property="Background" Value="#1A1E28" />
      <Setter Property="BorderBrush" Value="#14EEF0F5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#A3A9B8" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#232836" />
    </Style>
    <Style Selector="Button.mode.on /template/ ContentPresenter">
      <Setter Property="Background" Value="#232836" />
      <Setter Property="BorderBrush" Value="#4FB7D6" />
      <Setter Property="TextBlock.Foreground" Value="#EEF0F5" />
    </Style>
    <Style Selector="Button.mode.amber /template/ ContentPresenter">
      <Setter Property="Background" Value="#232836" />
      <Setter Property="BorderBrush" Value="#E0A23F" />
      <Setter Property="TextBlock.Foreground" Value="#EEF0F5" />
    </Style>

    <!-- primary action: off white on dark -->
    <Style Selector="Button#StartStop">
      <Setter Property="Background" Value="#EEF0F5" />
      <Setter Property="Foreground" Value="#0B0D14" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="24,12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button#StartStop:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D9DCE5" />
      <Setter Property="TextBlock.Foreground" Value="#0B0D14" />
    </Style>
  </Window.Styles>

  <!-- content runs under the title bar; any empty spot drags the window -->
  <Panel Background="Transparent" PointerPressed="OnDragWindow">
    <StackPanel Margin="24,40,24,24" Spacing="16">

      <!-- header -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="48" Height="48" CornerRadius="12" Background="#1A1E28" BorderBrush="#14EEF0F5" BorderThickness="1" Margin="0,0,16,0">
          <Image Source="/Assets/icon.png" Width="32" Height="32" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="DualSense Emulator" FontSize="24" FontWeight="Medium" Foreground="#EEF0F5" />
          <TextBlock Text="Your DualSense as a virtual Xbox 360 pad" Classes="dim" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Classes="pill">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#7A8296" VerticalAlignment="Center" />
              <TextBlock x:Name="ConnText" Text="Not connected" Classes="label" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="pill">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Grid Width="32" Height="14" VerticalAlignment="Center">
                <Border Width="28" Height="14" HorizontalAlignment="Left" CornerRadius="3" BorderBrush="#7A8296" BorderThickness="1" Padding="1">
                  <Border x:Name="BatteryFill" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="#4CC38A" />
                </Border>
                <Border Width="3" Height="6" HorizontalAlignment="Right" CornerRadius="1" Background="#7A8296" />
              </Grid>
              <TextBlock x:Name="BatteryText" Text="--" Classes="label" VerticalAlignment="Center" />
              <TextBlock x:Name="ChargeText" Text="" FontSize="14" Foreground="#A3A9B8" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <TabControl>
        <TabItem Header="Dashboard">
        <Grid ColumnDefinitions="480,*" ColumnSpacing="24">

          <!-- left: controller management -->
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="Controller management" FontSize="20" FontWeight="Medium" Foreground="#EEF0F5" />

              <!-- knob + stacked mode buttons -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                  <Button x:Name="SegEmulate" Classes="mode" Content="Emulate Xbox gamepad" Click="OnEmulate" />
                  <Button x:Name="SegOff" Classes="mode" Content="Passthrough (off)" Click="OnOff" />
                </StackPanel>
                <Border Width="128" Height="128" CornerRadius="64" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="#0B0D14" BorderBrush="#14EEF0F5" BorderThickness="1"
                        Cursor="Hand" PointerPressed="OnKnob" ToolTip.Tip="Click to turn emulation on or off">
                  <Panel>
                    <Path x:Name="KnobArc" Data="M 28,96 A 44,44 0 1 1 100,96" Stroke="#4FB7D6" StrokeThickness="6" StrokeLineCap="Round" />
                    <Border x:Name="KnobDial" Width="64" Height="64" CornerRadius="32" BorderBrush="#14EEF0F5" BorderThickness="1" Background="#1A1E28">
                      <Border x:Name="KnobTick" Width="4" Height="12" CornerRadius="2" Background="#4FB7D6" VerticalAlignment="Top" Margin="0,8,0,0" />
                    </Border>
                  </Panel>
                </Border>
              </Grid>

              <!-- current status -->
              <Border x:Name="StatusPanel" CornerRadius="10" BorderThickness="1" BorderBrush="#14EEF0F5" Background="#1A1E28" Padding="16">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#7A8296" VerticalAlignment="Center" />
                    <TextBlock FontSize="18" FontWeight="Medium" VerticalAlignment="Center">
                      <Run Text="Status  " Foreground="#A3A9B8" /><Run x:Name="StatusWord" Text="Off" Foreground="#7A8296" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock x:Name="StatusText" Text="" Classes="dim" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                  <Button x:Name="InstallVigem" Content="Install ViGEmBus driver" IsVisible="False" HorizontalAlignment="Center" Click="OnInstallVigem" />
                  <Button x:Name="StartStop" Content="Start emulation" Click="OnStartStop" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <!-- settings -->
              <StackPanel Spacing="12" >
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ToggleSwitch x:Name="HideToggle" OnContent="" OffContent="" Click="OnHideToggle" MinWidth="0" />
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Hide real pad" Classes="label" />
                    <TextBlock x:Name="HideText" Classes="dim" FontSize="12" TextWrapping="Wrap" MaxWidth="320" />
                  </StackPanel>
                </StackPanel>
                <Button x:Name="InstallHidHide" Content="Install HidHide" IsVisible="False" Click="OnInstallHidHide" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ToggleSwitch x:Name="StartupToggle" OnContent="" OffContent="" Click="OnStartupToggle" MinWidth="0" />
                  <TextBlock Text="Start with Windows (in tray)" Classes="label" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- right: live input -->
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="4">
              <TextBlock FontSize="16" VerticalAlignment="Center">
                <Run Text="Live input" FontWeight="Medium" Foreground="#EEF0F5" /><Run Text="   Active map translation" Foreground="#7A8296" FontSize="13" />
              </TextBlock>
              <Viewbox Height="230" Stretch="Uniform" Margin="0,8,0,0"><Canvas x:Name="DsCanvas" /></Viewbox>
              <TextBlock Text="PS5 DualSense" FontSize="14" FontWeight="Medium" Foreground="#A3A9B8" HorizontalAlignment="Center" />
              <Border Classes="badge"><TextBlock x:Name="TransTop" Text="Idle" Foreground="#A3A9B8" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace" /></Border>
              <Border Width="1" Height="16" Background="#7A8296" HorizontalAlignment="Center" />
              <Viewbox Height="230" Stretch="Uniform"><Canvas x:Name="XboxCanvas" /></Viewbox>
              <Border Classes="badge"><TextBlock x:Name="TransBottom" Text="Idle" Foreground="#A3A9B8" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace" /></Border>
              <TextBlock Text="Xbox 360 pad" FontSize="14" FontWeight="Medium" Foreground="#A3A9B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

        </Grid>
        </TabItem>
        <TabItem Header="Sticks">
          <Border Classes="card" Margin="0,16,0,0">
              <StackPanel Spacing="6" >
                <TextBlock Text="Stick deadzone" Classes="dim" />
                <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="0.4" ValueChanged="OnSlide" />
                <TextBlock Text="Stick curve (1 = linear)" Classes="dim" />
                <Slider x:Name="CurveSlider" Minimum="1" Maximum="3" ValueChanged="OnSlide" />
                <TextBlock Text="Trigger threshold" Classes="dim" />
                <Slider x:Name="TriggerSlider" Minimum="0" Maximum="100" ValueChanged="OnSlide" />
                <CheckBox x:Name="InvertYBox" Content="Invert Y (both sticks)" Click="OnCheck" />
                <CheckBox x:Name="SwapBox" Content="Swap sticks" Click="OnCheck" />
                <Button Content="Reset all tuning" Click="OnResetTuning" Margin="0,6,0,0" />
              </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="Buttons">
          <Border Classes="card" Margin="0,16,0,0">
              <StackPanel Spacing="12">
                <TextBlock Text="1. Pick a DualSense button   (amber = remapped)" Classes="dim" />
                <WrapPanel x:Name="RemapPanel" Orientation="Horizontal" />
                <TextBlock x:Name="RemapTitle" Classes="label" />
                <WrapPanel x:Name="RemapTargets" Orientation="Horizontal" />
              </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="Lightbar">
          <Border Classes="card" Margin="0,16,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Lightbar shows" Classes="label" />
              <WrapPanel x:Name="LightModePanel" Orientation="Horizontal">
                <RadioButton GroupName="lm" Tag="0" Content="Static colour" Click="OnLightMode" Margin="0,0,16,0" />
                <RadioButton GroupName="lm" Tag="1" Content="Battery level (green / amber / red)" Click="OnLightMode" Margin="0,0,16,0" />
                <RadioButton GroupName="lm" Tag="2" Content="Charging status" Click="OnLightMode" Margin="0,0,16,0" />
              </WrapPanel>
              <StackPanel x:Name="StaticPanel" Spacing="8">
                <TextBlock Text="Presets" Classes="dim" />
                <WrapPanel x:Name="PresetPanel" Orientation="Horizontal" />
                <TextBlock Text="Make your own" Classes="dim" />
                <Border x:Name="LightSwatch" Height="30" CornerRadius="8" BorderBrush="#262B38" BorderThickness="1" Background="Transparent" />
                <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Foreground="#E5484D" ValueChanged="OnRgb" />
                <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Foreground="#4CC38A" ValueChanged="OnRgb" />
                <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Foreground="#4FB7D6" ValueChanged="OnRgb" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox x:Name="LightbarBox" Width="120" Watermark="#RRGGBB" TextChanged="OnLightbar" />
                  <Button Content="Use pad's own colour" Click="OnLightbarClear" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Player LEDs show" Classes="label" Margin="0,8,0,0" />
              <WrapPanel x:Name="PlayerModePanel" Orientation="Horizontal">
                <RadioButton GroupName="pm" Tag="0" Content="Leave as is" Click="OnPlayerMode" Margin="0,0,16,0" />
                <RadioButton GroupName="pm" Tag="1" Content="Player number" Click="OnPlayerMode" Margin="0,0,16,0" />
                <RadioButton GroupName="pm" Tag="2" Content="Battery level (1-5 LEDs)" Click="OnPlayerMode" Margin="0,0,16,0" />
                <RadioButton GroupName="pm" Tag="3" Content="Charging (all lit)" Click="OnPlayerMode" Margin="0,0,16,0" />
              </WrapPanel>
              <WrapPanel x:Name="PlayerNumPanel" Orientation="Horizontal">
                <RadioButton GroupName="pn" Tag="1" Content="Player 1" Click="OnPlayerNum" Margin="0,0,16,0" />
                <RadioButton GroupName="pn" Tag="2" Content="Player 2" Click="OnPlayerNum" Margin="0,0,16,0" />
                <RadioButton GroupName="pn" Tag="3" Content="Player 3" Click="OnPlayerNum" Margin="0,0,16,0" />
                <RadioButton GroupName="pn" Tag="4" Content="Player 4" Click="OnPlayerNum" Margin="0,0,16,0" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </StackPanel>
  </Panel>
</Window>
