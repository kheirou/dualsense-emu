<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DualSenseEmu.Gui.MainWindow"
        Title="DualSense Emulator" Width="460" Height="520" CanResize="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" Text="Stopped" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="StartStop" Content="Start" Width="90" Click="OnStartStop" />
      <ToggleButton x:Name="HideToggle" Content="Hide real pad" Click="OnHideToggle" />
    </StackPanel>
    <TextBlock x:Name="HideText" Opacity="0.7" Text="" TextWrapping="Wrap" />
    <Separator />
    <TextBlock Text="Live input" FontWeight="SemiBold" />
    <TextBlock x:Name="ButtonsText" Text="-" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
      <TextBlock Grid.Row="0" Text="L2" /><ProgressBar x:Name="L2" Grid.Row="0" Grid.Column="1" Maximum="255" />
      <TextBlock Grid.Row="1" Text="R2" /><ProgressBar x:Name="R2" Grid.Row="1" Grid.Column="1" Maximum="255" />
      <TextBlock Grid.Row="2" Text="Left X" /><ProgressBar x:Name="LX" Grid.Row="2" Grid.Column="1" Maximum="255" />
      <TextBlock Grid.Row="3" Text="Left Y" /><ProgressBar x:Name="LY" Grid.Row="3" Grid.Column="1" Maximum="255" />
      <TextBlock Grid.Row="4" Text="Right X" /><ProgressBar x:Name="RX" Grid.Row="4" Grid.Column="1" Maximum="255" />
      <TextBlock Grid.Row="5" Text="Right Y" /><ProgressBar x:Name="RY" Grid.Row="5" Grid.Column="1" Maximum="255" />
    </Grid>
  </StackPanel>
</Window>
